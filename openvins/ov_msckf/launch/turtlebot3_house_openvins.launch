<launch>
  <!-- ================================================================ -->
  <!-- OpenVINS + TurtleBot3 Gazebo (turtlebot3_house) + RTAB-Map Demo -->
  <!-- Requires: turtlebot3_gazebo, rtabmap_ros                        -->
  <!-- ================================================================ -->

  <!-- Robot model -->
  <arg name="model" default="waffle" doc="model type [burger, waffle, waffle_pi]"/>
  <env name="TURTLEBOT3_MODEL" value="$(arg model)"/>

  <!-- Gazebo spawn position -->
  <arg name="x_pos" default="-3.0"/>
  <arg name="y_pos" default="1.0"/>
  <arg name="z_pos" default="0.0"/>

  <!-- OpenVINS config -->
  <arg name="config"      default="rgbd_mono"/>
  <arg name="config_path" default="$(find ov_msckf)/../config/$(arg config)/estimator_config.yaml"/>

  <!-- Visualization -->
  <arg name="rviz" default="true"/>
  <arg name="teleop" default="false"/>

  <!-- ================================================================ -->
  <!-- 1. Gazebo World -->
  <!-- ================================================================ -->
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(find turtlebot3_gazebo)/worlds/turtlebot3_house.world"/>
    <arg name="paused" value="false"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="gui" value="true"/>
    <arg name="headless" value="false"/>
    <arg name="debug" value="false"/>
  </include>

  <!-- ================================================================ -->
  <!-- 2. Robot Description (modified waffle with 640x480 camera & 400Hz IMU) -->
  <!-- ================================================================ -->
  <param name="robot_description"
         command="$(find xacro)/xacro --inorder $(find ov_msckf)/gazebo_models/urdf/turtlebot3_waffle_openvins.urdf.xacro" />

  <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher">
    <param name="publish_frequency" type="double" value="50.0" />
  </node>

  <!--
    OpenVINS publishes TF: global -> imu
    We need to bridge imu -> base_footprint so RTAB-Map can find global -> base_footprint.
    imu_link is 0.068m above base_link, base_footprint is 0.010m below base_link.
    So base_footprint is 0.078m below imu (which is co-located with imu_link).
  -->
  <node pkg="tf" type="static_transform_publisher" name="imu_frame_bridge"
        args="0 0 -0.078 0 0 0 imu base_footprint 100" />

  <!-- Spawn robot -->
  <node name="spawn_urdf" pkg="gazebo_ros" type="spawn_model"
        args="-urdf -model turtlebot3 -x $(arg x_pos) -y $(arg y_pos) -z $(arg z_pos) -param robot_description" />

  <!-- ================================================================ -->
  <!-- 3. OpenVINS (Monocular RGB + IMU) -->
  <!-- ================================================================ -->
  <node name="ov_msckf" pkg="ov_msckf" type="run_subscribe_msckf"
        output="screen" clear_params="true" required="false">
    <param name="verbosity"   type="string" value="INFO" />
    <param name="config_path" type="string" value="$(arg config_path)" />
    <param name="use_stereo"  type="bool"   value="true" />
    <param name="max_cameras" type="int"    value="1" />
  </node>

  <!-- ================================================================ -->
  <!-- 4. RTAB-Map (RGB-D Mapping using OpenVINS odometry) -->
  <!-- ================================================================ -->
  <group ns="rtabmap">
    <node name="rtabmap" pkg="rtabmap_slam" type="rtabmap" output="screen" args="--delete_db_on_start">
      <param name="frame_id"             type="string" value="base_footprint"/>
      <param name="subscribe_depth"      type="bool"   value="true"/>
      <param name="subscribe_scan"       type="bool"   value="false"/>
      <param name="approx_sync"          type="bool"   value="true"/>
      <param name="wait_for_transform_duration" type="double" value="0.2"/>

      <!-- Use OpenVINS odometry -->
      <param name="subscribe_odom_info"  type="bool"   value="false"/>
      <param name="gen_scan"             type="bool"   value="false"/>
      <param name="gen_depth"            type="bool"   value="false"/>

      <!-- RTAB-Map parameters tuned for simulation -->
      <param name="RGBD/NeighborLinkRefining" type="string" value="true"/>
      <param name="RGBD/ProximityBySpace"     type="string" value="true"/>
      <param name="RGBD/AngularUpdate"        type="string" value="0.01"/>
      <param name="RGBD/LinearUpdate"         type="string" value="0.01"/>
      <param name="RGBD/OptimizeFromGraphEnd" type="string" value="false"/>
      <param name="Reg/Strategy"              type="string" value="0"/> <!-- 0=Visual, 1=ICP -->

      <remap from="rgb/image"       to="/camera/rgb/image_raw"/>
      <remap from="depth/image"     to="/camera/depth/image_raw"/>
      <remap from="rgb/camera_info" to="/camera/rgb/camera_info"/>
      <remap from="odom"            to="/ov_msckf/odomimu"/>
    </node>
  </group>

  <!-- ================================================================ -->
  <!-- 5. Keyboard Teleop (optional, launch separately if needed) -->
  <!-- ================================================================ -->
  <group if="$(arg teleop)">
    <node name="teleop_keyboard" pkg="turtlebot3_teleop" type="turtlebot3_teleop_key"
          output="screen" launch-prefix="xterm -e">
      <remap from="cmd_vel" to="cmd_vel"/>
    </node>
  </group>

  <!-- ================================================================ -->
  <!-- 6. RViz -->
  <!-- ================================================================ -->
  <group if="$(arg rviz)">
    <node name="rviz" pkg="rviz" type="rviz"
          args="-d $(find turtlebot3_gazebo)/rviz/turtlebot3_gazebo_model.rviz" />
  </group>

</launch>
